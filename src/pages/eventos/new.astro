---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import LanguageTabs from "../../components/LanguageTabs.astro";
import { supabase } from "../../lib/supabase";
import { uploadToCloudinary } from "../../lib/cloudinary";

const profile = Astro.locals.profile;
if (!profile) {
    return Astro.redirect("/login");
}
if (profile.role !== "admin") {
    return Astro.redirect("/eventos");
}

let errorMessage = "";

const { data: establecimientos } = await supabase
    .from("establecimientos")
    .select("id, nombre")
    .order("nombre", { ascending: true });

if (Astro.request.method === "POST") {
    // Autenticar la sesión para evitar que RLS bloquee la inserción/actualización
    const accessToken = Astro.cookies.get('sb-access-token')?.value;
    const refreshToken = Astro.cookies.get('sb-refresh-token')?.value;
    if (accessToken && refreshToken) {
        await supabase.auth.setSession({
            access_token: accessToken,
            refresh_token: refreshToken
        });
    }

    const formData = await Astro.request.formData();
    const titulo = formData.get("titulo")?.toString();
    const descripcion = formData.get("descripcion")?.toString() || null;
    const fecha = formData.get("fecha")?.toString();
    const hora = formData.get("hora")?.toString() || "12:00";
    const establecimientoValue = formData.get("establecimiento_id")?.toString();
    const establecimiento_id = establecimientoValue ? Number(establecimientoValue) : null;
    const destacadoNivelValue = Number(formData.get("destacado_nivel") || 0);
    const destacado_nivel = [0, 1, 2].includes(destacadoNivelValue)
        ? destacadoNivelValue
        : 0;

    // Multi-language fields
    const titulo_en = formData.get("titulo_en")?.toString() || null;
    const titulo_de = formData.get("titulo_de")?.toString() || null;
    const titulo_fr = formData.get("titulo_fr")?.toString() || null;
    const descripcion_en = formData.get("descripcion_en")?.toString() || null;
    const descripcion_de = formData.get("descripcion_de")?.toString() || null;
    const descripcion_fr = formData.get("descripcion_fr")?.toString() || null;
    const imagenFile = formData.get("imagen") as File | null;

    if (titulo && fecha) {
        // Combine date and time
        const fechaCompleta = `${fecha}T${hora}:00`;
        let imagen_url: string | null = null;

        if (imagenFile && imagenFile.size > 0) {
            try {
                imagen_url = await uploadToCloudinary(imagenFile, "eventos");
            } catch (e: any) {
                errorMessage = `Error al subir imagen: ${e.message || "Error desconocido"}`;
            }
        }

        if (!errorMessage) {
            const { error } = await supabase.from("eventos").insert({
                titulo,
                descripcion,
                fecha: fechaCompleta,
                cultural: 0, // Always set to 0 for non-cultural events
                titulo_en,
                titulo_de,
                titulo_fr,
                descripcion_en,
                descripcion_de,
                descripcion_fr,
                imagen_url,
                destacado_nivel,
                establecimiento_id,
            });

            if (error) {
                errorMessage = error.message;
            } else {
                return Astro.redirect("/eventos");
            }
        }
    } else {
        errorMessage = "El título y la fecha son obligatorios.";
    }
}

// Get current date for default value
const today = new Date().toISOString().split("T")[0];
---

<Layout title="Nuevo Evento">
    <Navbar />

    <main class="max-w-2xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <div class="animate-fade-in">
            <!-- Breadcrumb -->
            <nav class="flex mb-8" aria-label="Breadcrumb">
                <ol role="list" class="flex items-center space-x-4">
                    <li>
                        <a
                            href="/eventos"
                            class="text-gray-400 hover:text-gray-500"
                        >
                            <svg
                                class="h-5 w-5"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 20 20"
                                fill="currentColor"
                            >
                                <path
                                    d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"
                                ></path>
                            </svg>
                        </a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <svg
                                class="h-5 w-5 text-gray-300"
                                xmlns="http://www.w3.org/2000/svg"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    d="M5.555 17.776l8-16 .894.448-8 16-.894-.448z"
                                ></path>
                            </svg>
                            <a
                                href="/eventos"
                                class="ml-4 text-sm font-medium text-gray-500 hover:text-gray-700"
                            >
                                Eventos
                            </a>
                        </div>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <svg
                                class="h-5 w-5 text-gray-300"
                                xmlns="http://www.w3.org/2000/svg"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    d="M5.555 17.776l8-16 .894.448-8 16-.894-.448z"
                                ></path>
                            </svg>
                            <span class="ml-4 text-sm font-medium text-gray-500"
                                >Nuevo Evento</span
                            >
                        </div>
                    </li>
                </ol>
            </nav>

            <div
                class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-xl overflow-hidden"
            >
                <div
                    class="px-6 py-5 text-white"
                    style="background: linear-gradient(to right, #3b82f6, #4f46e5);"
                >
                    <h3
                        class="text-lg leading-6 font-medium flex items-center gap-2"
                    >
                        <span class="text-xl">📅</span>
                        Nuevo Evento
                    </h3>
                    <p
                        class="mt-1 text-sm"
                        style="color: rgba(255,255,255,0.8);"
                    >
                        Añade un nuevo evento general.
                    </p>
                </div>

                <form method="POST" enctype="multipart/form-data" class="p-6 space-y-6">
                    {
                        errorMessage && (
                            <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded-md">
                                <p class="text-sm text-red-700">
                                    {errorMessage}
                                </p>
                            </div>
                        )
                    }

                    <!-- Título y Descripción con Traducciones -->
                    <div>
                        <h4
                            class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-4 flex items-center gap-2"
                        >
                            🌐 Información del Evento y Traducciones
                        </h4>

                        <!-- Language Tabs -->
                        <LanguageTabs
                            prefix="eventos"
                            fields={[
                                {
                                    name: "titulo",
                                    label: "Título del Evento",
                                    type: "input",
                                    placeholder: "Ej: Feria de Navidad",
                                    required: true,
                                },
                                {
                                    name: "descripcion",
                                    label: "Descripción",
                                    type: "textarea",
                                    placeholder: "Describe el evento...",
                                    rows: 4,
                                },
                            ]}
                        />
                    </div>

                    <div class="mb-6">
                        <h4
                            class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-4"
                        >
                            📷 Imagen
                        </h4>
                        <div
                            class="p-4 border-2 border-dashed border-gray-300 rounded-lg hover:border-blue-400 transition-colors"
                        >
                            <div id="imageDropZone" class="cursor-pointer text-center py-4">
                                <input
                                    type="file"
                                    id="imageFile"
                                    name="imagen"
                                    accept="image/*"
                                    class="hidden"
                                />
                                <span class="text-3xl block mb-2">📁</span>
                                <p class="text-sm text-gray-600">
                                    Haz clic o arrastra una imagen
                                </p>
                                <p class="text-xs text-gray-400">
                                    Bucket: eventos
                                </p>
                            </div>
                            <div id="imagePreviewContainer" class="hidden">
                                <img
                                    id="imagePreview"
                                    class="w-full h-40 object-cover rounded-lg"
                                />
                                <div class="flex justify-between items-center mt-2">
                                    <p
                                        id="imageFileName"
                                        class="text-xs text-gray-600 truncate flex-1"
                                    ></p>
                                    <button
                                        type="button"
                                        id="clearImage"
                                        class="text-xs text-red-600 hover:underline ml-2"
                                    >
                                        ✕ Quitar
                                    </button>
                                </div>
                                <div
                                    id="imageUploadStatus"
                                    class="hidden text-green-600 text-xs mt-1"
                                >
                                    ✓ Subida correctamente
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label
                                for="fecha"
                                class="block text-sm font-medium text-gray-700 mb-1"
                            >
                                Fecha <span class="text-red-500">*</span>
                            </label>
                            <input
                                type="date"
                                name="fecha"
                                id="fecha"
                                required
                                min={today}
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-primary-500 focus:border-primary-500"
                            />
                        </div>
                        <div>
                            <label
                                for="hora"
                                class="block text-sm font-medium text-gray-700 mb-1"
                            >
                                Hora
                            </label>
                            <input
                                type="time"
                                name="hora"
                                id="hora"
                                value="12:00"
                                class="w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-primary-500 focus:border-primary-500"
                            />
                        </div>
                    </div>

                    <div>
                        <label
                            for="establecimiento_id"
                            class="block text-sm font-medium text-gray-700 mb-1"
                        >
                            Establecimiento
                        </label>
                        <select
                            name="establecimiento_id"
                            id="establecimiento_id"
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-primary-500 focus:border-primary-500 bg-white"
                        >
                            <option value="">Sin establecimiento / en la calle</option>
                            {establecimientos?.map((establecimiento: any) => (
                                <option value={establecimiento.id}>
                                    {establecimiento.nombre}
                                </option>
                            ))}
                        </select>
                    </div>

                    <div>
                        <label
                            for="destacado_nivel"
                            class="block text-sm font-medium text-gray-700 mb-1"
                        >
                            Prioridad
                        </label>
                        <select
                            name="destacado_nivel"
                            id="destacado_nivel"
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-primary-500 focus:border-primary-500 bg-white"
                        >
                            <option value="0" selected>0 - Normal</option>
                            <option value="1">1 - Destacado</option>
                            <option value="2">2 - Premium</option>
                        </select>
                    </div>

                    <div
                        class="pt-5 border-t border-gray-100 flex justify-end gap-3"
                    >
                        <a
                            href="/eventos"
                            class="px-4 py-2 border border-gray-300 rounded-lg shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
                        >
                            Cancelar
                        </a>
                        <button
                            type="submit"
                            class="px-4 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 transition-all hover:-translate-y-0.5"
                        >
                            Crear Evento
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <script is:inline>
        document.addEventListener("DOMContentLoaded", function () {
            const imageDropZone = document.getElementById("imageDropZone");
            const imageFile = document.getElementById("imageFile");
            const imagePreviewContainer = document.getElementById("imagePreviewContainer");
            const imagePreview = document.getElementById("imagePreview");
            const imageFileName = document.getElementById("imageFileName");
            const imageUploadStatus = document.getElementById("imageUploadStatus");
            const clearImage = document.getElementById("clearImage");

            imageDropZone.addEventListener("click", () => imageFile.click());
            imageDropZone.addEventListener("dragover", (e) => {
                e.preventDefault();
                imageDropZone.classList.add("bg-blue-50");
            });
            imageDropZone.addEventListener("dragleave", () => {
                imageDropZone.classList.remove("bg-blue-50");
            });
            imageDropZone.addEventListener("drop", (e) => {
                e.preventDefault();
                imageDropZone.classList.remove("bg-blue-50");
                if (e.dataTransfer.files.length) {
                    imageFile.files = e.dataTransfer.files;
                    handleImageUpload(e.dataTransfer.files[0]);
                }
            });
            imageFile.addEventListener("change", (e) => {
                if (e.target.files.length) {
                    handleImageUpload(e.target.files[0]);
                }
            });
            clearImage.addEventListener("click", () => {
                imagePreviewContainer.classList.add("hidden");
                imageDropZone.classList.remove("hidden");
                imageUploadStatus.classList.add("hidden");
                imageFile.value = "";
            });

            async function handleImageUpload(file) {
                if (!file.type.startsWith("image/")) {
                    alert("Por favor selecciona una imagen");
                    return;
                }

                const reader = new FileReader();
                reader.onload = (e) => {
                    imagePreview.src = e.target.result;
                    imageFileName.textContent = file.name;
                    imagePreviewContainer.classList.remove("hidden");
                    imageDropZone.classList.add("hidden");
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
</Layout>
