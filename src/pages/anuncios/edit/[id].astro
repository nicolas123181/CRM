---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar.astro";
import { supabase } from "../../../lib/supabase";
import { uploadToCloudinary } from "../../../lib/cloudinary";

const { id } = Astro.params;
let errorMessage = "";

const [
    { data: anuncio, error: fetchError },
    { data: establecimientos },
    { data: programacionActual },
] =
    await Promise.all([
        supabase.from("anuncio_popup").select("*").eq("id", id).single(),
        supabase
            .from("establecimientos")
            .select("id, nombre")
            .order("nombre", { ascending: true }),
        supabase
            .from("anuncio_popup_programacion")
            .select("fecha_mostrar, prioridad, activo")
            .eq("anuncio_popup_id", id)
            .order("fecha_mostrar", { ascending: true }),
    ]);

if (fetchError || !anuncio) {
    return Astro.redirect("/anuncios");
}

let programacionItems = (programacionActual || []).map((item: any) => ({
    fecha_mostrar: item.fecha_mostrar,
    prioridad: Number(item.prioridad || 0),
    activo: item.activo !== false,
}));

if (Astro.request.method === "POST") {
    const accessToken = Astro.cookies.get("sb-access-token")?.value;
    const refreshToken = Astro.cookies.get("sb-refresh-token")?.value;
    if (accessToken && refreshToken) {
        await supabase.auth.setSession({
            access_token: accessToken,
            refresh_token: refreshToken,
        });
    }

    const formData = await Astro.request.formData();
    const titulo = formData.get("titulo")?.toString();
    const descripcion = formData.get("descripcion")?.toString() || null;
    const imagenFile = formData.get("imagen") as File | null;
    let imagen_url = formData.get("imagen_url")?.toString() || null;
    const establecimientoValue = formData.get("establecimiento_id")?.toString();
    const establecimiento_id = establecimientoValue ? Number(establecimientoValue) : null;
    const fechasMostrar = formData.getAll("fecha_mostrar").map((value) => value.toString()).filter(Boolean);
    const prioridades = formData.getAll("prioridad").map((value) => value.toString());
    const activos = new Set(formData.getAll("activo").map((value) => value.toString()));

    programacionItems = fechasMostrar.map((fecha_mostrar, index) => ({
        fecha_mostrar,
        prioridad: Number(prioridades[index] || 0),
        activo: activos.has(fecha_mostrar),
    }));

    if (titulo) {
        if (imagenFile && imagenFile.size > 0) {
            try {
                imagen_url = await uploadToCloudinary(imagenFile, "anuncios");
            } catch (e: any) {
                errorMessage = `Error al subir imagen: ${e.message || "Error desconocido"}`;
            }
        }

        if (errorMessage) {
            return;
        }

        const { error } = await supabase
            .from("anuncio_popup")
            .update({ titulo, descripcion, imagen_url, establecimiento_id })
            .eq("id", id);

        if (error) {
            errorMessage = error.message;
        } else {
            if (programacionItems.length > 0) {
                const { error: upsertProgramacionError } = await supabase
                    .from("anuncio_popup_programacion")
                    .upsert(programacionItems.map((item) => ({
                        anuncio_popup_id: Number(id),
                        fecha_mostrar: item.fecha_mostrar,
                        prioridad: item.prioridad,
                        activo: item.activo,
                    })), { onConflict: "anuncio_popup_id,fecha_mostrar" });

                if (upsertProgramacionError) {
                    errorMessage = upsertProgramacionError.message;
                } else {
                    const fechasSql = `(${programacionItems.map((item) => `"${item.fecha_mostrar}"`).join(",")})`;
                    const { error: deleteRemovedError } = await supabase
                        .from("anuncio_popup_programacion")
                        .delete()
                        .eq("anuncio_popup_id", id)
                        .not("fecha_mostrar", "in", fechasSql);

                    if (deleteRemovedError) {
                        errorMessage = deleteRemovedError.message;
                    } else {
                        return Astro.redirect("/anuncios");
                    }
                }
            } else {
                const { error: deleteProgramacionError } = await supabase
                    .from("anuncio_popup_programacion")
                    .delete()
                    .eq("anuncio_popup_id", id);

                if (deleteProgramacionError) {
                    errorMessage = deleteProgramacionError.message;
                } else {
                    return Astro.redirect("/anuncios");
                }
            }
        }
    } else {
        errorMessage = "El titulo es obligatorio.";
    }
}
---

<Layout title={`Editar: ${anuncio.titulo}`}>
    <Navbar />

    <main class="max-w-2xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-xl overflow-hidden">
            <div class="px-6 py-5 bg-blue-50 border-b border-blue-100">
                <h1 class="text-lg font-medium text-gray-900">Editar Anuncio</h1>
                <p class="text-sm text-gray-500">Actualiza popup.</p>
            </div>

            <form method="POST" enctype="multipart/form-data" class="p-6 space-y-6" id="anuncioForm">
                {errorMessage && (
                    <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded-md">
                        <p class="text-sm text-red-700">{errorMessage}</p>
                    </div>
                )}

                <div>
                    <label for="titulo" class="block text-sm font-medium text-gray-700 mb-1">
                        Titulo <span class="text-red-500">*</span>
                    </label>
                    <input type="text" name="titulo" id="titulo" required value={anuncio.titulo} class="w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-primary-500 focus:border-primary-500" />
                </div>

                <div>
                    <label for="descripcion" class="block text-sm font-medium text-gray-700 mb-1">
                        Descripcion
                    </label>
                    <textarea name="descripcion" id="descripcion" rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm focus:ring-primary-500 focus:border-primary-500">{anuncio.descripcion || ""}</textarea>
                </div>

                <div>
                    <label for="establecimiento_id" class="block text-sm font-medium text-gray-700 mb-1">
                        Establecimiento
                    </label>
                    <select name="establecimiento_id" id="establecimiento_id" class="w-full px-3 py-2 border border-gray-300 rounded-lg shadow-sm bg-white focus:ring-primary-500 focus:border-primary-500">
                        <option value="" selected={!anuncio.establecimiento_id}>
                            General / sin local
                        </option>
                        {establecimientos?.map((establecimiento: any) => (
                            <option value={establecimiento.id} selected={anuncio.establecimiento_id === establecimiento.id}>
                                {establecimiento.nombre}
                            </option>
                        ))}
                    </select>
                </div>

                <div>
                    <h2 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-4">Programacion diaria</h2>
                    <div class="space-y-3">
                        <div class="rounded-lg border border-gray-200 p-3">
                            <div class="flex items-center justify-between gap-3 mb-3">
                                <button type="button" id="prevMonthBtn" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50" aria-label="Mes anterior">
                                    &lt;
                                </button>
                                <p id="calendarMonthLabel" class="text-sm font-semibold text-gray-900"></p>
                                <button type="button" id="nextMonthBtn" class="px-3 py-2 rounded-lg text-sm font-medium text-gray-700 bg-white border border-gray-300 hover:bg-gray-50" aria-label="Mes siguiente">
                                    &gt;
                                </button>
                            </div>
                            <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold text-gray-500 mb-1">
                                <span>L</span>
                                <span>M</span>
                                <span>X</span>
                                <span>J</span>
                                <span>V</span>
                                <span>S</span>
                                <span>D</span>
                            </div>
                            <div id="calendarGrid" class="grid grid-cols-7 gap-1"></div>
                        </div>
                        <div class="flex justify-end">
                            <button type="button" id="addDateBtn" class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 disabled:opacity-50" disabled>
                                Anadir dias
                            </button>
                        </div>
                        <div id="selectedDates" class="space-y-2"></div>
                        <p class="text-xs text-gray-500">
                            Cada dia marcado crea un registro propio para busqueda rapida por fecha.
                        </p>
                    </div>
                </div>

                <div>
                    <h2 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-4">Imagen</h2>
                    <div class="p-4 border-2 border-dashed border-gray-300 rounded-lg hover:border-blue-400 transition-colors">
                        <input type="hidden" name="imagen_url" id="imagen_url" value={anuncio.imagen_url || ""} />
                        <div id="imageDropZone" class={`cursor-pointer text-center py-4 ${anuncio.imagen_url ? "hidden" : ""}`}>
                            <input type="file" id="imageFile" name="imagen" accept="image/*" class="hidden" />
                            <span class="text-3xl block mb-2">📁</span>
                            <p class="text-sm text-gray-600">Haz clic o arrastra una imagen</p>
                            <p class="text-xs text-gray-400">Bucket: anuncios</p>
                        </div>
                        <div id="imagePreviewContainer" class={anuncio.imagen_url ? "" : "hidden"}>
                            <img id="imagePreview" src={anuncio.imagen_url || ""} class="w-full h-40 object-cover rounded-lg" />
                            <div class="flex justify-between items-center mt-2">
                                <p id="imageFileName" class="text-xs text-gray-600 truncate flex-1">Imagen actual</p>
                                <button type="button" id="clearImage" class="text-xs text-red-600 hover:underline ml-2">
                                    Cambiar / quitar
                                </button>
                            </div>
                            <div id="imageUploadStatus" class="hidden text-xs mt-1"></div>
                        </div>
                    </div>
                </div>

                <div class="pt-5 border-t border-gray-100 flex justify-end gap-3">
                    <a href="/anuncios" class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">Cancelar</a>
                    <button type="submit" id="submitBtn" class="px-4 py-2 rounded-lg text-sm font-medium text-white bg-primary-600 hover:bg-primary-700">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </main>

    <script is:inline>
        document.addEventListener("DOMContentLoaded", function () {
            const imageDropZone = document.getElementById("imageDropZone");
            const imageFile = document.getElementById("imageFile");
            const imagePreviewContainer = document.getElementById("imagePreviewContainer");
            const imagePreview = document.getElementById("imagePreview");
            const imageFileName = document.getElementById("imageFileName");
            const imageUrlInput = document.getElementById("imagen_url");
            const imageUploadStatus = document.getElementById("imageUploadStatus");
            const clearImage = document.getElementById("clearImage");
            const submitBtn = document.getElementById("submitBtn");
            const addDateBtn = document.getElementById("addDateBtn");
            const selectedDates = document.getElementById("selectedDates");
            const calendarGrid = document.getElementById("calendarGrid");
            const calendarMonthLabel = document.getElementById("calendarMonthLabel");
            const prevMonthBtn = document.getElementById("prevMonthBtn");
            const nextMonthBtn = document.getElementById("nextMonthBtn");
            const initialDates = JSON.parse(document.getElementById("initialProgramacion").textContent || "[]");
            const dates = new Map(initialDates.map((item) => [item.fecha_mostrar, item]));
            const pendingDates = new Set();
            const today = new Date();
            let visibleYear = today.getFullYear();
            let visibleMonth = today.getMonth();

            renderCalendar();
            renderDates();

            imageDropZone.addEventListener("click", () => imageFile.click());
            addDateBtn.addEventListener("click", () => {
                pendingDates.forEach((dateKey) => {
                    if (!dates.has(dateKey)) {
                        dates.set(dateKey, { fecha_mostrar: dateKey, prioridad: 0, activo: true });
                    }
                });
                pendingDates.clear();
                renderCalendar();
                renderDates();
            });
            prevMonthBtn.addEventListener("click", () => {
                visibleMonth -= 1;
                if (visibleMonth < 0) {
                    visibleMonth = 11;
                    visibleYear -= 1;
                }
                pendingDates.clear();
                renderCalendar();
            });
            nextMonthBtn.addEventListener("click", () => {
                visibleMonth += 1;
                if (visibleMonth > 11) {
                    visibleMonth = 0;
                    visibleYear += 1;
                }
                pendingDates.clear();
                renderCalendar();
            });
            imageDropZone.addEventListener("dragover", (e) => {
                e.preventDefault();
                imageDropZone.classList.add("bg-blue-50");
            });
            imageDropZone.addEventListener("dragleave", () => imageDropZone.classList.remove("bg-blue-50"));
            imageDropZone.addEventListener("drop", (e) => {
                e.preventDefault();
                imageDropZone.classList.remove("bg-blue-50");
                if (e.dataTransfer.files.length) handleImageUpload(e.dataTransfer.files[0]);
            });
            imageFile.addEventListener("change", (e) => {
                if (e.target.files.length) handleImageUpload(e.target.files[0]);
            });
            clearImage.addEventListener("click", () => {
                imageUrlInput.value = "";
                imageFile.value = "";
                imagePreviewContainer.classList.add("hidden");
                imageDropZone.classList.remove("hidden");
                imageUploadStatus.classList.add("hidden");
            });
            document.getElementById("anuncioForm").addEventListener("submit", () => {
                submitBtn.disabled = true;
                submitBtn.textContent = "Guardando...";
                submitBtn.classList.add("opacity-50");
            });

            async function handleImageUpload(file) {
                if (!file.type.startsWith("image/")) {
                    alert("Por favor selecciona una imagen");
                    return;
                }

                const reader = new FileReader();
                reader.onload = (e) => {
                    imagePreview.src = e.target.result;
                    imageFileName.textContent = file.name;
                    imagePreviewContainer.classList.remove("hidden");
                    imageDropZone.classList.add("hidden");
                };
                reader.readAsDataURL(file);

                imageUploadStatus.textContent = "Imagen lista. Se subira al guardar.";
                imageUploadStatus.className = "text-green-600 text-xs mt-1";
            }

            function renderDates() {
                selectedDates.innerHTML = "";
                const orderedDates = Array.from(dates.values()).sort((a, b) => a.fecha_mostrar.localeCompare(b.fecha_mostrar));

                if (orderedDates.length === 0) {
                    selectedDates.innerHTML = '<p class="text-sm text-gray-500 py-2">Sin dias programados.</p>';
                    return;
                }

                orderedDates.forEach((item) => {
                    const row = document.createElement("div");
                    row.className = "grid grid-cols-1 sm:grid-cols-[1fr_110px_90px_80px] gap-2 items-center rounded-lg border border-gray-200 p-3";
                    row.innerHTML = `
                        <input type="hidden" name="fecha_mostrar" value="${item.fecha_mostrar}" />
                        <span class="text-sm font-medium text-gray-900">${item.fecha_mostrar}</span>
                        <select name="prioridad" class="w-full rounded-lg border-gray-300 text-sm" aria-label="Prioridad">
                            <option value="0" ${Number(item.prioridad || 0) === 0 ? "selected" : ""}>0</option>
                            <option value="1" ${Number(item.prioridad || 0) === 1 ? "selected" : ""}>1</option>
                            <option value="2" ${Number(item.prioridad || 0) === 2 ? "selected" : ""}>2</option>
                        </select>
                        <label class="flex items-center gap-2 text-sm text-gray-700">
                            <input type="checkbox" name="activo" value="${item.fecha_mostrar}" ${item.activo ? "checked" : ""} class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
                            Activo
                        </label>
                        <button type="button" class="text-sm font-medium text-red-600 hover:text-red-800" data-remove-date="${item.fecha_mostrar}">Quitar</button>
                    `;
                    row.querySelector("[name='prioridad']").addEventListener("change", (event) => {
                        item.prioridad = Number(event.target.value || 0);
                    });
                    row.querySelector("[name='activo']").addEventListener("change", (event) => {
                        item.activo = event.target.checked;
                    });
                    row.querySelector("[data-remove-date]").addEventListener("click", () => {
                        dates.delete(item.fecha_mostrar);
                        renderDates();
                    });
                    selectedDates.appendChild(row);
                });
            }

            function renderCalendar() {
                const monthNames = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
                calendarMonthLabel.textContent = `${monthNames[visibleMonth]} ${visibleYear}`;
                calendarGrid.innerHTML = "";

                const firstDay = new Date(visibleYear, visibleMonth, 1);
                const daysInMonth = new Date(visibleYear, visibleMonth + 1, 0).getDate();
                const firstWeekday = (firstDay.getDay() + 6) % 7;

                for (let i = 0; i < firstWeekday; i += 1) {
                    calendarGrid.appendChild(document.createElement("span"));
                }

                for (let day = 1; day <= daysInMonth; day += 1) {
                    const dateKey = `${visibleYear}-${String(visibleMonth + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
                    const button = document.createElement("button");
                    const alreadyAdded = dates.has(dateKey);
                    const selected = pendingDates.has(dateKey);
                    button.type = "button";
                    button.textContent = String(day);
                    button.disabled = alreadyAdded;
                    button.className = [
                        "aspect-square rounded-md text-sm font-medium border",
                        selected ? "bg-primary-600 text-white border-primary-600" : "bg-white text-gray-800 border-gray-200 hover:bg-blue-50",
                        alreadyAdded ? "opacity-40 cursor-not-allowed bg-gray-100" : "",
                    ].join(" ");
                    button.addEventListener("click", () => {
                        if (pendingDates.has(dateKey)) {
                            pendingDates.delete(dateKey);
                        } else {
                            pendingDates.add(dateKey);
                        }
                        renderCalendar();
                    });
                    calendarGrid.appendChild(button);
                }

                addDateBtn.disabled = pendingDates.size === 0;
                addDateBtn.textContent = pendingDates.size > 0 ? `Anadir ${pendingDates.size} dia${pendingDates.size === 1 ? "" : "s"}` : "Anadir dias";
            }
        });
    </script>
    <script is:inline type="application/json" id="initialProgramacion" set:html={JSON.stringify(programacionItems)}></script>
</Layout>
